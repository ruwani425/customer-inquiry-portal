# Backend server
PORT=4000
NODE_ENV=development

# Match POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_PORT, and POSTGRES_DB in root .env
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/inquiry_db

# Replace with a strong random secret (>= 32 chars) in non-local environments
JWT_SECRET=dev-change-this-secret-in-production-min-32-chars
CORS_ORIGIN=http://localhost:5173
